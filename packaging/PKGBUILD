# Maintainer: Jason Alexander <jason@greatspark.com>
# Builds Pipkin from this checkout plus a Pi engine checkout. Run from the repository root:
#   cd packaging && makepkg -si      (PI_CHECKOUT=../../pi-fork/pi by default)
pkgname=pipkin
pkgver=0.0.1
pkgrel=1
pkgdesc='Native Wayland desktop client for the Pi coding agent, with a bundled engine'
arch=('x86_64')
url='https://github.com/jasona/pipkin'
license=('custom')
depends=('nodejs>=22.19' 'wayland' 'libxkbcommon' 'vulkan-icd-loader' 'fontconfig' 'git')
makedepends=('rust' 'cargo' 'npm' 'zstd' 'clang' 'cmake')
optdepends=('foot: terminal for the "open terminal" action'
            'orca: screen reader'
            'fcitx5: input methods')
options=('!strip' '!lto')   # keep debug info; LTO flags break linking the bundled SQLite
PI_CHECKOUT=${PI_CHECKOUT:-"$startdir/../../pi-fork/pi"}

build() {
  cd "$startdir/.."
  scripts/package.sh "$PI_CHECKOUT"
}

package() {
  cp -a "$startdir/../dist/stage/." "$pkgdir/"
}
